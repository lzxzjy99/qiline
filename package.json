{
  "name": "qiline-web",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-hosted.mjs",
    "build:static": "node scripts/build-web.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "pages:deploy": "npm run build:pages && wrangler pages deploy --project-name qiline-online --branch main",
    "dev": "node node_modules/wrangler/bin/wrangler.js dev --config wrangler.preview.json --ip 127.0.0.1 --port 4174 --persist-to .wrangler/state",
    "db:generate": "drizzle-kit generate",
    "cloudflare:setup": "node scripts/cloudflare-setup.mjs",
    "cloudflare:publish": "node scripts/cloudflare-deploy.mjs",
    "cloudflare:deploy": "npm run build && npm run check && npm run cloudflare:publish",
    "publish:all": "node scripts/publish-github-cloudflare.mjs",
    "test:online": "node --experimental-sqlite --test tests/online.test.mjs tests/records.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-web.mjs",
    "build:ai": "node scripts/build-ai.mjs",
    "test:ai": "node --test tests/ai.test.mjs tests/ai-matrix.test.mjs tests/ai-tactics.test.mjs tests/ai-tactics-matrix.test.mjs",
    "test:search": "node --test tests/ai-tree.test.mjs tests/ai-search.test.mjs tests/ai-search-matrix.test.mjs",
    "test:worker": "node --test tests/ai-worker.test.mjs tests/ai-worker-native.test.mjs tests/ai-worker-matrix.test.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:desktop": "node --test tests/desktop.test.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "benchmark:generation": "node scripts/benchmark-generation-ai.mjs --holdout"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.44.0",
    "esbuild": "^0.25.0",
    "wrangler": "^4.30.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
